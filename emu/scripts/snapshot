#!/usr/bin/env bash
# Emulator path snapshot (PLAN.md 8.5). Usage: emu/scripts/snapshot NAME  (E0, or E0-s1 for one session)
# Zips PLAN.md, HANDOFF.md, CLAUDE.md, the emu/ sources, work/ref/ and the pinned third_party archives.
# Leaves out keys, work (except work/ref), dist, logs, docs/saves and snapshots. Never overwrites.
source "$(dirname "$0")/env.sh"
n=${1:?usage: emu/scripts/snapshot NAME}
out=snapshots/$n.zip
[ -e "$out" ] && { echo "$out already exists; snapshots are never overwritten" >&2; exit 1; }
mkdir -p snapshots work/snap
rm -rf work/snap/*
cp ../PLAN.md ../HANDOFF.md ../CLAUDE.md work/snap/
for d in bridge runner ref-oracle shell probe tools scripts docs; do
  [ -d "$d" ] && cp -r "$d" work/snap/
done
rm -rf work/snap/docs/saves
[ -d work/ref ] && { mkdir -p work/snap/work; cp -r work/ref work/snap/work/; }
if [ -d third_party/archives ]; then mkdir -p work/snap/third_party; cp -r third_party/archives work/snap/third_party/; fi
(cd work/snap && jar cfM "../../$out" .)
rm -rf work/snap
h=$(sha "$out")
sed -i "s#^- Latest emulator snapshot and SHA-256:.*#- Latest emulator snapshot and SHA-256: \`emu/$out\`, \`$h\`#" ../HANDOFF.md
echo "$out $h"
