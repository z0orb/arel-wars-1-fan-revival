#!/usr/bin/env bash
# Speed of p-heavy on the phone (PLAN.md TASK-E4.6, emu/docs/PERF.md).
#   emu/scripts/perf-heavy [N]   N runs each (default 3): reference oracle, runner -native none,
#                                runner -native all. Then one -prof run of the DES-12 start set
#                                (work/startset.txt) with -native none and one with -native all.
# A -prof hook on a replaced function never runs (the replace hook comes first). So the -prof run
# with -native all gives the time inside the start-set functions that are still emulated.
# Prints one line per run (tools/frame-stats.mjs, battle frames from params.json p_heavy_battle_from)
# and the prof share. Each run must give the reference hashes. Needs runner setup and ref-oracle setup.
source "$(dirname "$0")/env.sh"
N=${1:-3}
P() { node -p "require('./scripts/gates/params.json').$1"; }
SAVE=$(P p_heavy_save) FR=$(P p_heavy_frames) FROM=720
ARGS=(-frames "$FR" -script scripts/parity/p-heavy.txt -probe every:10 -quiet-sound)
ref=work/ref/p-heavy/frames.tsv
same() { cmp -s <(cut -f1-3 "$1") <(cut -f1-3 "$ref") && echo "hashes ok" || echo "hashes DIFF"; }
for i in $(seq 1 "$N"); do
  bash scripts/ref-oracle run "perf-ref-$i" "$SAVE" -- "${ARGS[@]}" >/dev/null 2>&1
  f=work/ref-oracle/runs/perf-ref-$i/frames.tsv
  echo "ref $i: $(node tools/frame-stats.mjs $FROM "$f" | cut -f2-) $(same "$f")"
done
for spec in none all; do
  for i in $(seq 1 "$N"); do
    bash scripts/runner run "perf-$spec-$i" "$SAVE" -- -native $spec "${ARGS[@]}" >/dev/null 2>&1
    f=work/runner/runs/perf-$spec-$i/frames.tsv
    echo "runner $spec $i: $(node tools/frame-stats.mjs $FROM "$f" | cut -f2-) $(same "$f")"
  done
done
for spec in none all; do
  bash scripts/runner run "perf-prof-$spec" "$SAVE" -- -native $spec "${ARGS[@]}" -prof work/startset.txt >/dev/null 2>&1
  d=work/runner/runs/perf-prof-$spec
  share=$(awk -F'\t' -v from=$FROM '$1 >= from { g += $2; p += $3; c += $4; n++ }
    END { printf "guest %.2f ms, start set %.2f ms (%.0f%%), %.0f calls a frame", g / n / 1000, p / n / 1000, 100 * p / g, c / n }' "$d/prof.tsv")
  echo "prof $spec: $share, $(same "$d/frames.tsv")"
done
