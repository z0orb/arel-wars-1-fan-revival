#!/usr/bin/env bash
# Builds the runner (arel-emu) or the bridge library for one ABI with NDK r27d (PLAN.md DES-15).
# Usage: emu/scripts/build-bridge ABI [runner|lib]   (ABI arm64-v8a or x86_64; default runner).
#   runner  work/bridge/ABI/arel-emu: a PIE program for /data/local/tmp, static C++ library.
#   lib     work/bridge/ABI/libgameDSO.so: the bridge, with the guest embedded (.incbin) and the
#           trampolines from tools/gen-exports.mjs. Environment (emu/scripts/build sets them):
#             GUEST_SO       the guest (default: work/guest/libgameDSO.so from emu/scripts/guest)
#             DEXDUMP        "dexdump -d" of the shell classes.dex (default: work/shell-debug/dexdump.txt)
#             BUILD_VARIANT  debug (AREL_DEBUG=1) or release (default debug)
# Needs emu/scripts/build-core ABI first.
source "$(dirname "$0")/env.sh"
ABI=${1:?usage: emu/scripts/build-bridge ABI [runner|lib]}
WHAT=${2:-runner}
case "$ABI" in arm64-v8a) T=aarch64-linux-android21 ;; x86_64) T=x86_64-linux-android21 ;; *) echo "bad ABI" >&2; exit 2 ;; esac
C=work/core/$ABI/install
[ -f $C/lib/libdynarmic.a ] || { echo "run emu/scripts/build-core $ABI first" >&2; exit 1; }
O=work/bridge/$ABI
mkdir -p $O
LIBS="$C/lib/libdynarmic.a $C/lib/libmcl.a $C/lib/libfmt.a"
[ -f $C/lib/libZydis.a ] && LIBS="$LIBS $C/lib/libZydis.a"
[ -f $C/lib/libZycore.a ] && LIBS="$LIBS $C/lib/libZycore.a"
COMMON="bridge/src/guest.cpp bridge/src/loader.cpp bridge/src/shims.cpp bridge/src/fmt.cpp bridge/src/core_dynarmic.cpp
  bridge/src/native/native.cpp bridge/src/native/blit.cpp bridge/src/native/screen.cpp
  bridge/src/native/prim.cpp bridge/src/native/text.cpp"
# -fwrapv: the native replacements use Java int rules (bridge/src/native/native.h).
FLAGS=(--target=$T -std=c++20 -O2 -g -fwrapv -Wall -Wextra -Wno-unused-parameter -I$C/include -Iwork/core-src/boost
  -Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384 -static-libstdc++)

if [ "$WHAT" = runner ]; then
  "$TC/clang++.exe" "${FLAGS[@]}" -DAREL_NATIVE_MUT_BUILD -fPIE -pie -o $O/arel-emu $COMMON bridge/src/jni_fake.cpp runner/src/main.cpp runner/src/vec.cpp $LIBS -lm
  echo "built $O/arel-emu $(sha $O/arel-emu)"
  exit 0
fi
[ "$WHAT" = lib ] || { echo "second argument must be runner or lib" >&2; exit 2; }

GUEST_SO=${GUEST_SO:-$(bash scripts/guest)}
DEXDUMP=${DEXDUMP:-work/shell-debug/dexdump.txt}
VARIANT=${BUILD_VARIANT:-debug}
[ -f "$DEXDUMP" ] || { echo "no $DEXDUMP: run emu/scripts/build first" >&2; exit 1; }
want=$(node -p "require('./scripts/gates/params.json').guest_sha256")
[ "$(sha "$GUEST_SO")" = "$want" ] || { echo "guest hash differs from params.json" >&2; exit 1; }
G=work/bridge/gen
mkdir -p $G
node tools/gen-exports.mjs "$GUEST_SO" "$DEXDUMP" $G/exports.cpp
node tools/gen-jni-names.mjs "$(cygpath -m "$TC/../sysroot/usr/include/jni.h")" $G/jni_names.cpp
printf '#pragma once\n#define GUEST_SHA256 "%s"\n' "$want" >$G/guest_hash.h
cat >$G/blob.S <<EOF
// Generated by emu/scripts/build-bridge: the guest as a read-only blob (PLAN.md DES-03).
    .section .rodata
    .balign 16
    .global arel_guest_start
    .hidden arel_guest_start
    .global arel_guest_end
    .hidden arel_guest_end
arel_guest_start:
    .incbin "$(cygpath -m "$PWD/$GUEST_SO")"
arel_guest_end:
EOF
"$TC/clang.exe" --target=$T -fPIC -c -o $O/blob.o $G/blob.S
DBG=0; [ "$VARIANT" = debug ] && DBG=1
"$TC/clang++.exe" "${FLAGS[@]}" -fPIC -shared -fvisibility=hidden -DAREL_DEBUG=$DBG -Ibridge/src -I$G \
  -Wl,--exclude-libs,ALL -Wl,-soname,libgameDSO.so \
  -o $O/libgameDSO.so $COMMON bridge/src/jni_real.cpp bridge/src/gl_real.cpp bridge/src/bridge.cpp $G/exports.cpp $G/jni_names.cpp $O/blob.o \
  $LIBS -lGLESv1_CM -llog -lm
echo "built $O/libgameDSO.so ($VARIANT) $(sha $O/libgameDSO.so)"
