#!/usr/bin/env bash
# Release QA. Set SOAK_ON_THROWAWAY_SAVE=1 only after confirming the phone holds a throwaway save.
source "$(dirname "$0")/../env.sh"; source scripts/gates/lib.sh
gate_start 7
bash scripts/gates/gate-3 release && pass "gate-3 on release" || fail "gate-3 on release"
bash scripts/gates/gate-4 && pass "gate-4" || fail "gate-4"
bash scripts/gates/gate-5 release && pass "gate-5 on release" || fail "gate-5 on release"
if [ "${SOAK_ON_THROWAWAY_SAVE:-}" = 1 ]; then
  bash scripts/gates/gate-6 release && pass "gate-6 on release" || fail "gate-6 on release"
  # Test-save swap, status bar lock, detached monkey, streamed logcat and dropbox checks: see soak.
  bash scripts/gates/soak && pass "soak on release, no FATAL" || fail "soak on release"
else
  fail "gate-6 and soak not run: needs SOAK_ON_THROWAWAY_SAVE=1 on a throwaway save"
fi
[ -s docs/QA.md ] && pass "docs/QA.md exists" || fail "docs/QA.md exists"
[ -s docs/INSTALL.md ] && pass "docs/INSTALL.md exists" || fail "docs/INSTALL.md exists"
owner_confirmed accepted && pass "owner played and accepted (docs/OWNER.md)" || fail "owner played and accepted (docs/OWNER.md needs 'accepted: yes')"
owner_confirmed backed-up && pass "owner backed up keys, snapshots, original and a save" || fail "owner backup (docs/OWNER.md needs 'backed-up: yes')"
gate_end
